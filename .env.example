# --- Trigger layer ---
# "email"   : TradingView -> (email) -> Cloudflare Email Worker -> POST /webhook
# "webhook" : TradingView Webhook -> POST /webhook directly (future)
TRIGGER_MODE=email

# --- Judgment Engine (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
JUDGMENT_CONFIDENCE_THRESHOLD=0.6
JUDGMENT_MAX_TOKENS=1024

# --- Risk Manager ---
RISK_MAX_POSITION_SIZE_USD=100
RISK_MAX_LEVERAGE=3

# --- Order layer ---
# Comma-separated SYMBOL:exchange pairs. exchange is "hyperliquid" or "backpack".
SYMBOL_EXCHANGE_MAP=BPUSDT:backpack,HYPEUSD:hyperliquid
ORDER_MAX_RETRIES=3
ORDER_RETRY_BASE_DELAY_SECONDS=2

HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=

BACKPACK_API_URL=https://api.backpack.exchange
BACKPACK_API_KEY=
BACKPACK_API_SECRET=

# --- Storage ---
DATABASE_PATH=data/trading_bot.db

# --- Notification (LINE Messaging API) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO_USER_ID=
